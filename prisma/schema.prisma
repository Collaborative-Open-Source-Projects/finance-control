generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  type      String
  icon      String
  color     String
  budgetLimit Float?  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}